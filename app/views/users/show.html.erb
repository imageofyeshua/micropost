<%# debug @user %>
<%# simple_format @user.to_yaml %>
<% provide :title, @user.name %>
<h1 class="flex flex-row max-auto text-center font-bold px-10">
  <div class="pr-5">
    <%= gravatar_for(@user.email, 60) %>
  </div>
  <div class="font-bold text-2xl pt-6">
    <%= @user.name %>
  </div>
  <div class="text-xl text-blue-600 pt-6 ml-4">
    <%= @user.email %>
  </div>
</h1>

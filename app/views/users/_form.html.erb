<%= form_with(model: @user) do |f| %>
  <!-- Error Messages -->
  <%= render 'shared/error_messages', object: @user %>

  <%= f.text_field :name, class: "w-full p-4 mb-4 border border-gray-300 rounded-md placeholder:font-light", placeholder: "Enter your name" %>

  <%= f.email_field :email, class: "w-full p-4 mb-4 border border-gray-300 rounded-md placeholder:font-light", placeholder: "Enter your email" %>

  <%= f.password_field :password, class: "w-full p-4 mb-4 border border-gray-300 rounded-md placeholder:font-light", placeholder: "Enter the password" %>

  <%= f.password_field :password_confirmation, class: "w-full p-4 mb-4 border border-gray-300 rounded-md placeholder:font-light", placeholder: "Password confirmation" %>

  <%= f.submit yield(:button_text), class: "w-full md:w-auto flex justify-center items-center p-4 space-x-4 font-bold text-white rounded-md shadow-lg px-9 bg-cyan-700 shadow-cyan-100 hover:bg-opacity-90 shadow-sm hover:shadow-lg border transition hover:-translate-y-0.5 duration-150" %>
<% end %>

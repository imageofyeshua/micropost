<% provide :title, "All users" %>
<h1 class="text-xl font-bold mb-4">All users</h1>

<%= render partial: "shared/pagination", locals: { records: @users, position: "top" } %>

<ul class="pagination">
  <% @users.each do |user| %>
    <li class="flex flex-row gap-2 mb-3">
      <%= gravatar_for(user.email, 50) %> 
      <div class="px-3 py-3 font-bold hover:text-gray-400">
        <%= link_to user.name, user %>
      </div>
    </li>
  <% end %>
</ul>

<%= render partial: "shared/pagination", locals: { records: @users, position: "bottom" } %>


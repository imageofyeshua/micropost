<% provide :title, "All users" %>
<h1 class="text-xl font-bold mb-4">All users</h1>

<ul class="">
  <% @users.each do |user| %>
    <li class="flex flex-row gap-2 mb-3">
      <%= gravatar_for(user.email, 50) %> 
      <div class="px-3 py-3 font-bold hover:text-gray-400">
        <%= link_to user.name, user %>
      </div>
    </li>
  <% end %>
</ul>

<div class="text-center my-4">
  <div role="navigation" aria-label="Pagination" class="px-3 py-2 mx-2 text-gray-700 no-underline bg-white rounded-lg">
    <div class="flickr_pagination">
      <div class="py-4">
        <%= page_entries_info @users %>
      </div>
      <div class="py-4">
        <%= will_paginate @users %>
      </div>
    </div>
  </div>
</div>

<% provide :title, "Sign up" %>
<!-- Card Container -->
<div class="flex flex-col max-w-2xl space-y-10 bg-white shadow-2xl rounded-2xl md:flex-row md:space-y-0 md:m-0">
  <!-- Left Side -->
  <div class="p-6 md:p-20">
    <!-- Top Content -->
    <h2 class="mb-5 text-4xl font-bold">
      Sign up
    </h2>
    <p class="max-w-sm mb-12 text-xl text-gray-800">
    Sign up to be the member of this website
    </p>
    <%= form_with(model: @user) do |f| %>
      <!-- Error Messages -->
      <%= render 'shared/error_messages' %>

      <%= f.text_field :name, class: "w-full p-4 mb-4 border border-gray-300 rounded-md placeholder:font-light", placeholder: "Enter your name" %>
      <%= f.email_field :email, class: "w-full p-4 mb-4 border border-gray-300 rounded-md placeholder:font-light", placeholder: "Enter your email" %>
      <%= f.password_field :password, class: "w-full p-4 mb-4 border border-gray-300 rounded-md placeholder:font-light", placeholder: "Enter the password" %>
      <%= f.password_field :password_confirmation, class: "w-full p-4 mb-4 border border-gray-300 rounded-md placeholder:font-light", placeholder: "Password confirmation" %>
      <%= f.submit "Create my account", class: "w-full md:w-auto flex justify-center items-center p-4 space-x-4 font-bold text-white rounded-md shadow-lg px-9 bg-cyan-700 shadow-cyan-100 hover:bg-opacity-90 shadow-sm hover:shadow-lg border transition hover:-translate-y-0.5 duration-150" %>
    <% end %>
  </div>
</div>

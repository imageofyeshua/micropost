<div class="flex flex-col max-w-2xl space-y-10 bg-white shadow-2xl rounded-2xl md:flex-row md:space-y-0 md:m-0">
  <div class="p-6 md:p-20">
    <!-- Top Content -->
    <h2 class="mb-5 text-4xl font-bold">
      Sign up
    </h2>
    <p class="max-w-sm mb-12 text-xl text-gray-800">
    Sign up to be the member of this website
    </p>
    <%= render 'form' %>
  </div>
</div>

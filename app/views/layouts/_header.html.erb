<!-- Header Section -->
<div class="container max-w-6xl mx-auto px-6 py-12 mb-20">
  <!-- Menu/Logo Container -->
  <nav class="flex items-center justify-between font-bold text-slate-500">
    <%= link_to "Ekklesia", root_path, class: "font-bold text-4xl" %>
    <!-- Menu -->
    <div class="hidden h-10 font-alata text-xl md:flex md:space-x-8">
      <div class="group">
        <%= link_to "Home", root_path, class: "hover:text-gray-400" %>
        <div class="mx-1 group-hover:border-b-2 group-hover:border-blue-300"></div>
      </div>
      <div class="group">
        <%= link_to "Help", help_path, class: "hover:text-gray-400" %>
        <div class="mx-1 group-hover:border-b-2 group-hover:border-blue-300"></div>
      </div>
      <div class="group">
        <%= link_to "About", about_path, class: "hover:text-gray-400" %>
        <div class="mx-1 group-hover:border-b-2 group-hover:border-blue-300"></div>
      </div>
      <div class="group">
        <%= link_to "Contact", contact_path, class: "hover:text-gray-400" %>
        <div class="mx-1 group-hover:border-b-2 group-hover:border-blue-300"></div>
      </div>
      <% if logged_in? %>
        <!-- Right Side Menu -->
        <div class="relative" data-controller="dropdown">
          <button 
            class="flex items-center space-x-2 hover:text-gray-400 focus:outline-none"
            data-action="click->dropdown#toggle"
            >
            <span>Account</span>
            <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
              d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Menu -->
          <div 
            data-dropdown-target="menu"
            class="flex flex-col absolute right-0 mt-2 w-40 bg-white text-gray-700 rounded-lg shadow-lg hidden z-20"
            >
            <div class="w-full text-left font-light text-lg px-4 py-2 hover:bg-blue-100 hover:text-blue-700 text-blue-800" >
              <%= link_to "Profile" %>
            </div>
            <div class="w-full text-left font-light text-lg px-4 py-2 hover:bg-blue-100 hover:text-blue-700 text-blue-800" >
              <%= link_to "Settings", edit_user_path(current_user) %>
            </div>
            <hr class="my-1 border-gray-200">
            <%= button_to "Logout", logout_path, method: :delete, class: "w-full text-left font-light text-lg px-4 py-2 hover:bg-rose-100  hover:text-rose-700 text-rose-800" %>
          </div>
        </div>
      <% else %>
        <div class="group">
          <%= link_to "Login", login_path, class: "" %>
          <div class="mx-1 group-hover:border-b-2 group-hover:border-blue-300"></div>
        </div>
      <% end %>
    </div>
    <!-- Hamburger Button -->
  </nav>
  <!-- Mobile Menu -->
</div>

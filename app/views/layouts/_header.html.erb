<!-- Header Section -->
<div class="container max-w-6xl mx-auto px-6 py-12 mb-20">
  <!-- Menu/Logo Container -->
  <nav class="flex items-center justify-between font-bold text-slate-500">
    <%= link_to "Ekklesia", root_path, class: "font-bold text-4xl" %>
    <!-- Menu -->
    <div class="hidden h-10 font-alata text-xl md:flex md:space-x-8">
      <div class="group">
        <%= link_to "Home", root_path, class: "" %>
        <div class="mx-1 group-hover:border-b-2 group-hover:border-blue-300"></div>
      </div>
      <div class="group">
        <%= link_to "Help", help_path, class: "" %>
        <div class="mx-1 group-hover:border-b-2 group-hover:border-blue-300"></div>
      </div>
      <div class="group">
        <%= link_to "About", about_path, class: "" %>
        <div class="mx-1 group-hover:border-b-2 group-hover:border-blue-300"></div>
      </div>
      <div class="group">
        <%= link_to "Contact", contact_path, class: "" %>
        <div class="mx-1 group-hover:border-b-2 group-hover:border-blue-300"></div>
      </div>
      <% if logged_in? %>
        <div class="group">
          <%= link_to "Profile", class: "" %>
          <div class="mx-1 group-hover:border-b-2 group-hover:border-blue-300"></div>
        </div>
        <div class="group">
          <%= link_to "Logout", logout_path, data: { "turbo_method": :delete }, class: "" %>
          <div class="mx-1 group-hover:border-b-2 group-hover:border-blue-300"></div>
        </div>
      <% else %>
        <div class="group">
          <%= link_to "Login", login_path, class: "" %>
          <div class="mx-1 group-hover:border-b-2 group-hover:border-blue-300"></div>
        </div>
      <% end %>
    </div>
    <!-- Hamburger Button -->
  </nav>
  <!-- Mobile Menu -->
</div>

<% provide :title, "Log in" %>
<!-- Card Container -->
<div class="flex flex-col max-w-2xl space-y-10 bg-white shadow-2xl rounded-2xl md:flex-row md:space-y-0 md:m-0">
  <!-- Left Side -->
  <div class="p-6 md:p-20">
    <!-- Top Content -->
    <h2 class="mb-5 text-4xl font-bold">
      Log in
    </h2>
    <p class="max-w-sm mb-12 text-xl text-gray-800">
      Log in with your email and password
    </p>
    <%= form_with(url: login_path, scope: :session) do |f| %>
      <%= f.email_field :email, class: "w-full p-4 mb-4 border border-gray-300 rounded-md placeholder:font-light", placeholder: "Enter your email" %>
      <%= f.password_field :password, class: "w-full p-4 mb-4 border border-gray-300 rounded-md placeholder:font-light", placeholder: "Enter the password" %>
      <%= f.submit "Log in", class: "w-full md:w-auto flex justify-center items-center p-4 space-x-4 font-bold text-white rounded-md shadow-lg px-9 bg-cyan-700 shadow-cyan-100 hover:bg-opacity-90 shadow-sm hover:shadow-lg border transition hover:-translate-y-0.5 duration-150" %>
    <% end %>
    <p class="mt-5 font-bold text-blue-800">New user? <%= link_to "Sign up now!", signup_path %></p>
  </div>
</div>

<% content_for :title, "Home | Last Generation Last Days" %>

<section id="hero">
  <div class="section-container mb-40">
    <%= image_tag "logo.svg", alt: "logo image", class: "mx-auto my-16" %>
    <h3>
      A history of everything you have walked...
    </h3>
    <p class="mx-w-3xl mx-auto mb-10 text-2xl text-grayish-blue">
    Our Father in heaven, sanctified be Thy Name, Thy kingdom come, Thy will be done on earth as it is in heaven...
    </p>

    <!-- Button Container -->   
    <div class="button-container">
      <%= link_to "Read Bible", root_path, class: "p-4 px-8 mr-2 rounded-full shadow-lg bg-strong-cyan duration-200 hover:opacity-80" %>
      <%= link_to "Blog Messages", root_path, class: "p-4 px-8 rounded-full shadow-lg bg-light-blue duration-200 hover:opacity-80" %>
    </div>

    <!-- Snippets Section -->
    <section id="snippet">
      <div class="section-container my-20">
        <h3>
          Beware of the Wolves in Sheep's Clothing
        </h3>
        <p class="section-content mb-24 text-xl">
        Give us this day our daily bread, And forgive us our trespasses, As we also forgive them that trespass against us. And lead us not into temptation. But deliver us from evil . For Thine is the kingdom, the power, and the glory Forever and ever...
        </p>
      </div>
    </section>

    <!-- Features Section -->
    <section id="features">
      <div class="section-container my-20">
        <div class="relative flex flex-col md:flex-row md:space-x-32">
          <!-- Image -->
          <div class="md:w-1/2">
            <%= image_tag "image-computer.png", alt: "computer image", class: "md:absolute top-0 right-[50%]" %>
          </div>
          <!-- Items Container -->
          <div class="flex flex-col mt-16 mb-24 space-y-12 text-xl md:w-1/2 md:mb-60 md:text-left md:pl-16">
            <!-- Item 1 -->
            <div>
              <h5>
                Quick Search
              </h5>
              <p class="max-w-md text-grayish-blue">
              Easily search your snippets by content, category, web address, application, and more.
              </p>
            </div>
            <!-- Item 2 -->
            <div>
              <h5>
                iCloud Sync
              </h5>
              <p class="max-w-md text-grayish-blue">Instantly saves and syncs snippets across all your devices.</p>
            </div>
            <!-- Item 3 -->
            <div>
              <h5>
                Completely History
              </h5>
              <p class="max-w-md text-grayish-blue">
              Retrieve any snippets from the first moment you started using the app.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Access Anywhere Section -->
    <section id="access">
      <div class="section-container my-20">
        <h3>Access Clipboard Anywhere</h3>
        <p class="section-content mb-24 text-xl">
        Whether you're on the go, or at your computer, you can access all your Clipboard snippets in a few simple clicks.
        </p>
        <%= image_tag "image-devices.png", alt: "", class: "mx-auto" %>
      </div>
    </section>

    <!-- Supercharge Section -->
    <section id="supercharge">
      <div class="section-container my-20 text-xl">
        <h3>Supercharge your workflow</h3>
        <p class="section-content mb-16">
        We've got the tools to boost your productivity.
        </p>
        <!-- Items Container -->
        <div class="flex-col items-center justify-between space-y-16 md:flex-row md:space-y-0 md:space-x-12">
          <!-- Item 1 -->
          <div class="flex flex-col items-center space-y-5">
            <%= image_tag "icon-blacklist.svg", alt: "", class: "mb-6" %>
            <h5>Create Blacklists</h5>
            <p class="max-w-md text-grayish-blue">
            Easily search your snippets by content, category, web address, application, and more.
            </p>
          </div>
          <!-- Item 2 -->
          <div class="flex flex-col items-center space-y-5">
            <%= image_tag "icon-text.svg", alt: "", class: "mb-6" %>
            <h5>Plain Text Snippets</h5>
            <p class="max-w-md text-grayish-blue">
            Remove unwated formatting from copied text for a consistent look.
            </p>
          </div>
          <!-- Item 3 -->
          <div class="flex flex-col items-center space-y-5">
            <%= image_tag "icon-preview.svg", alt: "", class: "mb-6" %>
            <h5>Sneak Preview</h5>
            <p class="max-w-md text-grayish-blue">
            Quick preview of all snippets on your Clipboard for easy access.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- References Section -->
    <section id="references">
      <div class="flex flex-col items-center justify-between max-w-6xl px-10 mx-auto space-y-16 my-44 md:flex-row md:space-y-0">
        <%= image_tag "logo-google.png", alt: "", class: "" %>
        <%= image_tag "logo-ibm.png", alt: "", class: "" %>
        <%= image_tag "logo-microsoft.png", alt: "", class: "" %>
        <%= image_tag "logo-hp.png", alt: "", class: "" %>
        <%= image_tag "logo-vector-graphics.png", alt: "", class: "" %>
      </div>
    </section>

    <!-- Bottom CTA Section -->
    <section id="bottom">
      <div class="section-container my-20 text-xl">
        <h3>Clipboard for iOS and MacOS</h3>
        <p class="section-content mb-10">
        Available for free on the App Store. Download for Mac or iOS sync with iCloud and you're ready to start adding to your clipboard.
        </p>
        <!-- Bottom CTA Section -->
        <div class="button-container">
          <div class="button-container">
            <%= link_to "Read Bible", root_path, class: "p-4 px-8 mr-2 rounded-full shadow-lg bg-strong-cyan duration-200 hover:opacity-80" %>
            <%= link_to "Blog Messages", root_path, class: "p-4 px-8 rounded-full shadow-lg bg-light-blue duration-200 hover:opacity-80" %>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Footer -->
    <footer class="bg-gray-50">
      <div class="section-container">
        <div class="flex flex-col items-center justify-between md:flex-row">

          <!-- Image -->
          <%= image_tag "logo.svg", alt: "", class: "scale-50" %>
          <!-- Container for Menus & Social -->
          <div class="flex flex-col items-center justify-between flex-1 mb-10 space-y-6 md:flex-row md:mb-0 md:space-y-0 text-grayish-blue">
            <div class="flex flex-col space-y-4 md:flex-row md:ml-24 md:space-x-24 md:space-y-0">

              <!-- Menu 1 -->
              <div class="flex flex-col space-y-4 text-center md:text-left">
                <div>
                  <%= link_to "FAQs", root_path, class: "hover:text-strong-cyan" %>
                </div>
                <div>
                  <%= link_to "Contact Us", root_path, class: "hover:text-strong-cyan" %>
                </div>
              </div>

              <!-- Menu 2 -->
              <div class="flex flex-col space-y-4 text-center md:text-left">
                <div>
                  <%= link_to "Privacy Policy", root_path, class: "hover:text-strong-cyan" %>
                </div>
                <div>
                  <%= link_to "Press Kit", root_path, class: "hover:text-strong-cyan" %>
              </div>

              <!-- Menu 3 -->
              <div class="flex flex-col space-y-4 text-center md:text-left">
                <div>
                  <%= link_to "Install Guide", root_path, class: "hover:text-strong-cyan" %>
                </div>
              </div>
            </div>
            <!-- Social Icons -->
            <div class="flex justify-between w-32 py-1" >
              <a href="#">
                <%= image_tag "icon-facebook.svg", alt: "", class: "duration-200 ficon" %>
              </a>
              <a href="#">
                <%= image_tag "icon-twitter.svg", alt: "", class: "duration-200 ficon" %>
              </a>
              <a href="#">
                <%= image_tag "icon-instagram.svg", alt: "", class: "duration-200 ficon" %>
              </a>
            </div>
          </div>
        </div>
      </div>
    </footer>

  </div>
</section>
